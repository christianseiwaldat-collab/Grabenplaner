[Unit]
Description=Grabenplaner host security audit
After=network-online.target ssh.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/grabenplaner-host-security audit --write-status
TimeoutStartSec=5min
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ReadWritePaths=/var/lib/grabenplaner-host-security
CapabilityBoundingSet=CAP_CHOWN CAP_NET_ADMIN
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

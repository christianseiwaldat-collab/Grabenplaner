[Unit]
Description=Isolierter Grabenplaner Recovery-Application-Smoke-Test
Documentation=https://github.com/christianseiwaldat-collab/Grabenplaner/blob/main/SERVERBETRIEB.md
After=network.target

[Service]
Type=oneshot
User=grabenplaner-offsite
Group=grabenplaner-offsite
# Nur diese isolierte Unit darf den root:grabenplaner-App-Code lesen. Das
# Dienstkonto erhaelt dadurch keine dauerhafte Gruppenmitgliedschaft; Live-Daten
# und Konfiguration bleiben weiterhin per InaccessiblePaths gesperrt.
SupplementaryGroups=grabenplaner
WorkingDirectory=/opt/grabenplaner/app
ExecStart=/opt/grabenplaner-offsite/module/grabenplaner-offsite-application-smoke.sh
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateMounts=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressAllow=localhost
IPAddressDeny=any
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
# Der reale App-Start darf den Produktivhost auch bei defektem Restore-Stand
# nicht verdraengen. 768 MiB und ein CPU-Kern reichen fuer Node/SQLite-Startup
# und beide Health-Endpunkte, bleiben aber klar unterhalb eines Vollbetriebs.
MemoryHigh=512M
MemoryMax=768M
MemorySwapMax=0
TasksMax=128
LimitNOFILE=1024
LimitCORE=0
CPUQuota=100%
CPUWeight=10
IOWeight=10
Nice=10
OOMPolicy=stop
ReadOnlyPaths=/opt/grabenplaner/app /opt/grabenplaner-offsite/module
ReadWritePaths=/var/lib/grabenplaner-offsite/application-smoke
InaccessiblePaths=/etc/grabenplaner /var/lib/grabenplaner /var/backups/grabenplaner /var/log/grabenplaner /var/lib/grabenplaner-assurance /run/grabenplaner-assurance-control /var/lib/grabenplaner-offsite/credentials /var/lib/grabenplaner-offsite/uploader-home /var/lib/grabenplaner-offsite/staging /var/lib/grabenplaner-offsite/restore-tests /var/lib/grabenplaner-offsite/status.json
TimeoutStartSec=120s
TimeoutStopSec=15s
RuntimeMaxSec=120s
KillMode=control-group

[Unit]
Description=Grabenplaner Recovery Assurance (%i)
Documentation=https://github.com/christianseiwaldat-collab/Grabenplaner/blob/main/SERVERBETRIEB.md
Wants=network-online.target
After=network-online.target grabenplaner.service

[Service]
Type=oneshot
ExecStart=/opt/grabenplaner-offsite/module/grabenplaner-offsite-assurance.sh --trigger %i
LoadCredential=repository:/etc/grabenplaner/offsite/repository
LoadCredential=repository-id:/etc/grabenplaner/offsite/repository-id
LoadCredential=installation-id:/etc/grabenplaner/offsite/installation-id
LoadCredential=restic-password:/etc/grabenplaner/offsite/restic-password
LoadCredential=rclone-config-password:/etc/grabenplaner/offsite/rclone-config-password
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
RuntimeDirectory=grabenplaner-offsite
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ReadWritePaths=/var/lib/grabenplaner /var/backups/grabenplaner /var/lib/grabenplaner-offsite /var/lib/grabenplaner-assurance /run/grabenplaner /run/grabenplaner-offsite
TimeoutStartSec=40h

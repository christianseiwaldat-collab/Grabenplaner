[Unit]
Description=Grabenplaner verschluesseltes Offsite-Backup uebertragen
Documentation=https://github.com/christianseiwaldat-collab/Grabenplaner/blob/main/SERVERBETRIEB.md
Wants=network-online.target
After=network-online.target grabenplaner-offsite-prepare.service
Requires=grabenplaner-offsite-prepare.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/grabenplaner-offsite/module/grabenplaner-offsite-upload.sh
LoadCredential=repository:/etc/grabenplaner/offsite/repository
LoadCredential=repository-id:/etc/grabenplaner/offsite/repository-id
LoadCredential=installation-id:/etc/grabenplaner/offsite/installation-id
LoadCredential=restic-password:/etc/grabenplaner/offsite/restic-password
LoadCredential=rclone-config-password:/etc/grabenplaner/offsite/rclone-config-password
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
ReadWritePaths=/var/lib/grabenplaner-offsite /run/grabenplaner-offsite
TimeoutStartSec=8h

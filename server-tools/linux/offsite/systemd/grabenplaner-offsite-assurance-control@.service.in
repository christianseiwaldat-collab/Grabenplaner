[Unit]
Description=Grabenplaner Recovery-Assurance-Steuerungsanforderung
Documentation=https://github.com/christianseiwaldat-collab/Grabenplaner/blob/main/SERVERBETRIEB.md
Requires=grabenplaner-offsite-assurance-control.socket
After=grabenplaner-offsite-assurance-control.socket

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/flock --exclusive --wait 3 /run/grabenplaner-assurance-control/broker.lock /usr/bin/node /opt/grabenplaner-offsite/module/lib/assurance-control-broker.js
StandardInput=socket
StandardOutput=socket
StandardError=journal
UMask=0077
TimeoutStartSec=12s
TimeoutStopSec=5s
RuntimeMaxSec=15s

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
DevicePolicy=closed
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
ReadWritePaths=/run/grabenplaner-assurance-control

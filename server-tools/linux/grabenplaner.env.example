# Grabenplaner production environment for systemd.
# The installer renders this template to /etc/grabenplaner/grabenplaner.env
# with mode 0600. Never commit or copy the rendered file.
NODE_ENV=production
TZ=Europe/Vienna
GRABENPLANER_OPERATION_MODE=server
GRABENPLANER_DEPLOYMENT_KIND=production
GRABENPLANER_PUBLIC_URL={{PUBLIC_URL}}
GRABENPLANER_HOST=127.0.0.1
GRABENPLANER_TRUST_PROXY=loopback
PORT={{PORT}}
GRABENPLANER_DATA_DIR=/var/lib/grabenplaner
DB_PATH=/var/lib/grabenplaner/data/dienstplan.db
BACKUP_DIR=/var/backups/grabenplaner
GRABENPLANER_LOG_DIR=/var/log/grabenplaner/app
GRABENPLANER_BACKUP_KEEP=30
GRABENPLANER_AMU_KEY_ID=server-v1
GRABENPLANER_AMU_KEY={{AMU_KEY}}
GRABENPLANER_INTEGRATION_KEY_ID=server-v1
GRABENPLANER_INTEGRATION_KEY={{INTEGRATION_KEY}}
GRABENPLANER_WIFI_IDENTITY_KEY={{WIFI_IDENTITY_KEY}}
GRABENPLANER_WIFI_WEBHOOK_SECRET={{WIFI_WEBHOOK_SECRET}}
GRABENPLANER_SERVICE_CONTROL_TOKEN={{SERVICE_CONTROL_TOKEN}}
# Einmaliger, root-only Bootstrap-Schluessel. Nach erfolgreichem HTTPS-Start
# wird der Wert atomar geleert und kann nicht erneut verwendet werden.
GRABENPLANER_BOOTSTRAP_TOKEN={{BOOTSTRAP_TOKEN}}

# Optionaler Transaktionsmail-Provider. Ohne Scaleway-Zugangsdaten,
# ausdrueckliche Versandfreigabe und Ereignis-Positivliste bleibt der Versand
# fail-closed deaktiviert. Antworten werden nicht entgegengenommen.
# GRABENPLANER_EMAIL_PROVIDER=scaleway-tem
# GRABENPLANER_EMAIL_FROM=Grabenplaner <benachrichtigung@grabenplaner.eu>
# GRABENPLANER_SCALEWAY_TEM_PROJECT_ID=<Scaleway-Projekt-ID>
# GRABENPLANER_SCALEWAY_TEM_SECRET_KEY=<eingeschraenkter TEM-API-Schluessel>
# GRABENPLANER_EMAIL_DISPATCH_ENABLED=0
# GRABENPLANER_EMAIL_ALLOWED_EVENTS=

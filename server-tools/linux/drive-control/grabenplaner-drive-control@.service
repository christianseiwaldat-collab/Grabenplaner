[Unit]
Description=Grabenplaner manual Drive backup control request
Requires=grabenplaner-drive-control.socket
After=grabenplaner-drive-control.socket network-online.target

[Service]
Type=oneshot
# Keep the default system-service root identity, as in the existing Offsite
# units, for the dedicated uploader handoff under NoNewPrivileges.
Group=root
ExecStart=/usr/bin/flock --exclusive --wait 3 /run/grabenplaner-drive-control/broker.lock /usr/bin/node /opt/grabenplaner/app/server-tools/linux/lib/manual-drive-control.js broker
StandardInput=socket
StandardOutput=socket
StandardError=journal
UMask=0077
TimeoutStartSec=32s
TimeoutStopSec=5s
RuntimeMaxSec=34s
RuntimeDirectory=grabenplaner-drive-control
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/run/grabenplaner-drive-control /run/grabenplaner /run/grabenplaner-offsite /var/lib/grabenplaner-offsite
MemoryMax=256M
TasksMax=64
LimitCORE=0

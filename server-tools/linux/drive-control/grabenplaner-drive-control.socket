[Unit]
Description=Grabenplaner manual Google Drive backup control

[Socket]
ListenStream=/run/grabenplaner-drive-control/request.sock
SocketUser=root
SocketGroup=grabenplaner-assurance-control
SocketMode=0660
DirectoryMode=0755
Accept=yes
MaxConnections=4
RemoveOnStop=yes
FlushPending=yes

[Install]
WantedBy=sockets.target

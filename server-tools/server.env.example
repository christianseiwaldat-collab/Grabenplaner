# Beispielwerte fuer einen zentralen Grabenplaner-Server.
# Der Windows-Einrichtungsassistent uebernimmt diese Werte in die geschuetzte
# WinSW-Dienstkonfiguration. Diese Datei wird nicht automatisch geladen.

NODE_ENV=production
GRABENPLANER_OPERATION_MODE=server
GRABENPLANER_PUBLIC_URL=https://plan.example.at
GRABENPLANER_HOST=127.0.0.1
GRABENPLANER_TRUST_PROXY=loopback
PORT=3000
GRABENPLANER_DATA_DIR=C:\ProgramData\Grabenplaner
DB_PATH=C:\ProgramData\Grabenplaner\data\dienstplan.db
BACKUP_DIR=D:\Grabenplaner-Backups
GRABENPLANER_LOG_DIR=C:\ProgramData\Grabenplaner\logs
GRABENPLANER_BACKUP_KEEP=30
GRABENPLANER_AMU_KEY_ID=server-v1
GRABENPLANER_AMU_KEY=<32-Byte-Schluessel als Base64; geheim und getrennt sichern>
GRABENPLANER_SERVICE_CONTROL_TOKEN=<mindestens 32 zufaellige Zeichen; geheim>

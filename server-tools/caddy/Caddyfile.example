{
	admin off

	# Optional kann hier eine neutrale Kontaktadresse fuer ACME eingetragen werden:
	# email admin@example.at
}

{{PUBLIC_HOST}} {
	encode zstd gzip
	@serviceStop path /api/service/stop
	respond @serviceStop 404

	reverse_proxy {{UPSTREAM}} {
		health_uri /api/health/live
		health_interval 30s
		health_timeout 5s
	}

	header -Server

	log {
		output file "{{CADDY_LOG_PATH}}" {
			roll_size 10MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}
}

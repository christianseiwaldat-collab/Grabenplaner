{
  "name": "grabenplaner",
  "version": "0.75.3-beta",
  "private": true,
  "description": "Web-App zur Erstellung und zum PDF-Export von Wochendienstplänen",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test --test-concurrency=1",
    "codespaces": "node scripts/codespaces-runner.js",
    "developer:set": "node scripts/set-developer.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.7.0",
  "dependencies": {
    "@tesseract.js-data/deu": "1.0.0",
    "exceljs": "4.4.0",
    "express": "^5.1.0",
    "pdfjs-dist": "6.1.200",
    "pdfkit": "^0.17.1",
    "quill": "2.0.0",
    "sharp": "0.34.5",
    "tedious": "20.0.0",
    "tesseract.js": "7.0.0"
  }
}
